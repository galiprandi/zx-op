generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PlayerSession {
  id                  String        @id @default(cuid())
  barcodeId           String        @unique
  totalAllowedSeconds Int           @default(0)
  accumulatedSeconds  Int           @default(0)
  lapsCount           Int           @default(0)
  lastStartAt         DateTime?
  isActive            Boolean       @default(false)
  expiresAt           DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  logs                SessionLog[]
  transactions        Transaction[]
  checkinSales        CheckinSale[]
}

model SessionLog {
  id              String        @id @default(cuid())
  playerSession   PlayerSession @relation(fields: [playerSessionId], references: [id], onDelete: Cascade)
  playerSessionId String
  action          LogAction
  data            Json?
  createdAt       DateTime      @default(now())
}

model Product {
  id               String   @id @default(cuid())
  name             String
  description      String?
  price            Float
  category         String
  required         Boolean @default(false)
  timeValueSeconds Int?
  isDeleted        Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  transactions     Transaction[]
}

model ProductCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id              String        @id @default(cuid())
  playerSession   PlayerSession @relation(fields: [playerSessionId], references: [id], onDelete: Cascade)
  playerSessionId String
  checkinSale     CheckinSale?  @relation(fields: [checkinSaleId], references: [id], onDelete: SetNull)
  checkinSaleId   String?
  product         Product       @relation(fields: [productId], references: [id])
  productId       String
  quantity        Int           @default(1)
  totalPrice      Float
  createdAt       DateTime      @default(now())
}

model PaymentMethod {
  id          String                         @id @default(cuid())
  name        String                         @unique
  isActive    Boolean                        @default(true)
  isDeleted   Boolean                        @default(false)
  createdAt   DateTime                       @default(now())
  updatedAt   DateTime                       @updatedAt
  allocations CheckinSalePaymentAllocation[]
}

model CheckinSale {
  id                 String                         @id @default(cuid())
  playerSession      PlayerSession                  @relation(fields: [playerSessionId], references: [id], onDelete: Cascade)
  playerSessionId    String
  barcodeIdSnapshot  String
  totalAmount        Float
  createdAt          DateTime                       @default(now())
  transactions       Transaction[]
  paymentAllocations CheckinSalePaymentAllocation[]
}

model CheckinSalePaymentAllocation {
  id              String       @id @default(cuid())
  checkinSale     CheckinSale  @relation(fields: [checkinSaleId], references: [id], onDelete: Cascade)
  checkinSaleId   String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  paymentMethodId String
  amount          Float
  createdAt       DateTime      @default(now())
}

model SystemSetting {
  id            String   @id @default("system")
  maxOccupancy  Int      @default(100)
  siteName      String?  @default("Zona Xtreme")
  logoUrl       String?
  operationalDayStart String @default("07:00")
  timezone      String   @default("America/Argentina/Tucuman")
  autoExpireGraceMinutes Int @default(5)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum LogAction {
  CHECKIN
  PLAY
  PAUSE
  TIME_ADDED
  AUTO_EXPIRE
  LAP
}
